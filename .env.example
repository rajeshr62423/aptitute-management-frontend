# AptitudePro Frontend Environment Configuration Example
# Copy this file to .env.local or .env for local development

# Base URL of the AptitudePro NestJS backend API (without trailing /api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Set to 'true' to use local browser mock storage instead of backend API
# Set to 'false' to communicate with the live NestJS backend API
NEXT_PUBLIC_USE_MOCK=false
